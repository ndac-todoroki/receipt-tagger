# Cloudflare Tunnel のトークン（Zero Trust ダッシュボードでトンネル作成時に発行される）
TUNNEL_TOKEN=
# tunnel にすると cloudflared も起動する（docker compose up でもデプロイの hook でも）
# COMPOSE_PROFILES=tunnel

# ホスト側の公開ポート（既定 8080）
APP_PORT=8080

# 読み取り用モデルの重みを置く Hugging Face キャッシュ（既定 ~/.cache/huggingface）
# HF_CACHE_DIR=

# 品目ジャンルの分類器。embedding（Ruri の類似度）か llm（vllm の制約付きデコーディング）
# ITEM_CLASSIFIER=llm
